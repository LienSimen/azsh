{
  "name": "azeroth-shell",
  "version": "0.1.0",
  "type": "module",
  "description": "Azeroth shell. A WoW Classic 1.12 text RPG for the terminal, built on CMaNGOS data. Terminal fork of phonecraft.",
  "keywords": ["wow", "classic", "rpg", "terminal", "game", "tui", "cmangos"],
  "bin": {
    "azsh": "bin/azsh.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "docs/"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node bin/azsh.mjs",
    "check": "node --import ./src/cli/register.mjs src/cli/bootCheck.mjs",
    "data:pack": "node scripts/pack-data.mjs",
    "data:unpack": "node scripts/pack-data.mjs --unpack",
    "build:exe": "node scripts/build-exe.mjs",
    "check:tui": "node --import ./src/cli/register.mjs src/cli/tuiCheck.mjs",
    "check:pipe": "node scripts/tui-pipe-check.mjs",
    "check:all": "npm run check && npm run check:tui && npm run check:pipe"
  }
}
