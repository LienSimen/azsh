{
  "name": "azsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Azeroth shell. A WoW Classic 1.12 text RPG for the terminal, built on CMaNGOS data. Terminal fork of phonecraft.",
  "bin": {
    "azsh": "bin/azsh.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node bin/azsh.mjs",
    "check": "node --import ./src/cli/register.mjs src/cli/bootCheck.mjs",
    "data:pack": "node scripts/pack-data.mjs",
    "data:unpack": "node scripts/pack-data.mjs --unpack"
  }
}
