{
  "name": "azeroth-shell",
  "version": "0.3.0",
  "type": "module",
  "description": "Azeroth shell. A WoW Classic 1.12 text RPG for the terminal, built on CMaNGOS data.",
  "keywords": [
    "wow",
    "classic",
    "rpg",
    "terminal",
    "game",
    "tui",
    "cmangos"
  ],
  "author": "Simen Lien",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LienSimen/azsh.git"
  },
  "bugs": {
    "url": "https://github.com/LienSimen/azsh/issues"
  },
  "homepage": "https://github.com/LienSimen/azsh#readme",
  "bin": {
    "azeroth-shell": "bin/azsh.mjs",
    "azsh": "bin/azsh.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "!src/data/*-hd.bin.br",
    "!src/data/gear-art-hd/",
    "!src/data/*.only.bin.br",
    "!src/data/gear-art-hd.only/",
    "docs/"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "npm run check:all",
    "start": "node bin/azsh.mjs",
    "check": "node --import ./src/cli/register.mjs src/cli/bootCheck.mjs",
    "data:pack": "node scripts/pack-data.mjs",
    "data:unpack": "node scripts/pack-data.mjs --unpack",
    "art:bake": "node scripts/bake-model-art.mjs && node scripts/bake-model-art.mjs --worn",
    "art:gear": "python scripts/bake-gear-art.py",
    "art:icons": "node scripts/bake-icon-art.mjs",
    "art:map": "node scripts/bake-world-map.mjs && node scripts/bake-world-map.mjs --sixel",
    "art:hd": "node scripts/bake-model-art.mjs --hd && node scripts/bake-icon-art.mjs --hd && python scripts/bake-gear-art.py --hd",
    "art:publish": "node scripts/publish-hd-art.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "check:tui": "node --import ./src/cli/register.mjs src/cli/tuiCheck.mjs",
    "check:pipe": "node scripts/tui-pipe-check.mjs",
    "check:perf": "node --import ./src/cli/register.mjs src/cli/perfCheck.mjs",
    "check:all": "npm run check && npm run check:tui && npm run check:pipe"
  }
}
